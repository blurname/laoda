{
  "name": "laoda",
  "version": "0.0.3",
  "bin": {
    "laoda": "dist/index.js"
  },
  "workspaces": [
    "apps/*"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "version-bump": "cox root-version-bump",
    "tag-push": "cox tag-push",
    "dev": "tsx index.ts",
    "build": "mkdir -p dist && esbuild ./index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --external:@hono/node-server --external:ws --external:chokidar --banner:js=\"#!/usr/bin/env node\"",
    "start": "NODE_ENV=production node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint -c .oxlintrc.json",
    "format": "oxfmt ."
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "chokidar": "^5.0.0",
    "hono": "^4.11.5",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "coxswain": "1.0.11",
    "esbuild": "^0.24.0",
    "oxfmt": "^0.26.0",
    "oxlint": "latest",
    "tsx": "^4.19.2",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  }
}
